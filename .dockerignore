# Исключаем локальные файлы секретов и базы данных
.env
.env.*
bot_texts.json

# Исключаем кэш компиляции Python (самое главное)
__pycache__/
*.pyc
*.pyo
*.pyd

# Исключаем скрытые папки систем контроля версий и окружений
.git/
.gitignore
venv/
.venv/
env/

# Исключаем файлы и кэш систем тестирования (если появятся в будущем)
.pytest_cache/
.coverage
htmlcov/
tests/
.cov/
pytest.ini

#исключаем файл документации
README.md

# Исключаем технический мусор операционных систем и сред разработки
.DS_Store
.idea/
.vscode/
*.swp
*.bak