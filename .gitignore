# Секреты и настройки окружения
.env
.env.local
.env.*.local
*.env

# Зависимости (логируются менеджерами пакетов, но сами файлы в Git не нужны)
node_modules/
__pycache__/
*.pyc
venv/
.venv/
ENV/

# Логи и отчеты об ошибках
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Системные файлы (создаются Windows и macOS автоматически)
.DS_Store
Thumbs.db

# Настройки редакторов кода (IDE)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

#  скрываем тесты
tests/
test_/
*test*.py
requirements-dev.txt


# Следы работы тестов и отчеты о покрытии (оставляем в .gitignore навсегда!)
.pytest_cache/
.htmlcov/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
pip-log.txt
